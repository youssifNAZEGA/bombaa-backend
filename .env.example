# ---------------------------------------------------------------------------
# BOMBAA - variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
# Le fichier .env est ignoré par Git et ne doit jamais être commité.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_NAME=bombaa_dev
DB_USER=bombaa_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS (front web / dashboard)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PayDunya
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=BOMBAA
PAYDUNYA_RETURN_URL=http://localhost:3000/paiement/retour
PAYDUNYA_CANCEL_URL=http://localhost:3000/paiement/annule
PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/payments/webhooks/paydunya/
